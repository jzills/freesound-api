{
	"name": "freesound-api",
	"version": "1.0.6",
	"keywords": ["api", "audio", "fluent", "freesound", "freesound.org"],
	"main": "./dist/freesound-api.js",
	"types": "./dist/freesound-api.d.ts",
	"type": "module",
	"exports": {
		".": {
			"import": "./dist/freesound-api.js",
			"require": "./dist/freesound-api.cjs"
		}
	},
	"scripts": {
		"start": "node dist/index.js",
		"dev": "vite",
		"build": "vite build",
		"test": "vitest test/unit --watch",
		"test:integration": "vitest run --config vitest.integration.config.ts"
	},
	"author": "Joshua Zillwood",
	"license": "MIT",
	"description": "A freesound.org API client library.",
	"files": [
		"dist"
	],
	"devDependencies": {
		"@types/node": "^25.6.0",
		"vite": "^8.0.10",
		"vite-plugin-dts": "^5.0.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.5"
	}
}
